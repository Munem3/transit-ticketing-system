<mxfile host="app.diagrams.net" type="device">
  <diagram name="Communication - Cancel and Refund" id="comm-cancel">
    <mxGraphModel dx="1300" dy="820" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Communication Diagram — Cancel &amp; Refund" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#0F766E;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="560" height="26" as="geometry" />
        </mxCell>

        <!-- Objects -->
        <mxCell id="oC" value="&lt;u&gt;: Commuter&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="130" height="54" as="geometry" />
        </mxCell>
        <mxCell id="oUI" value="&lt;u&gt;ui : Tickets UI&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="300" width="150" height="54" as="geometry" />
        </mxCell>
        <mxCell id="oCtrl" value="&lt;u&gt;ctrl : cancelBooking()&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#0D9488;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="296" width="190" height="62" as="geometry" />
        </mxCell>

        <mxCell id="oBooking" value="&lt;u&gt;booking : Booking&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="70" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oSeat" value="&lt;u&gt;seat : Seat [1..*]&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="200" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oWallet" value="&lt;u&gt;user : Wallet (balance)&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="410" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oTxn" value="&lt;u&gt;txn : Transaction&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="530" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- Commuter <-> UI -->
        <mxCell id="e1" value="1: tap Cancel" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;exitX=1;exitY=0.32;entryX=0;entryY=0.32;" edge="1" parent="1" source="oC" target="oUI"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="4: show updated tickets &amp; balance" style="endArrow=block;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="oUI" target="oC"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- UI <-> Ctrl -->
        <mxCell id="e2" value="2: cancelBooking(bookingId)" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;exitX=1;exitY=0.32;entryX=0;entryY=0.32;" edge="1" parent="1" source="oUI" target="oCtrl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="3: cancelled &amp; refunded" style="endArrow=block;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;exitX=0;exitY=0.72;entryX=1;entryY=0.72;" edge="1" parent="1" source="oCtrl" target="oUI"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Ctrl -> domain objects (nested numbering) -->
        <mxCell id="eb" value="2.1: verify owner &amp; status&#10;2.3: set status = CANCELLED" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="oCtrl" target="oBooking"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="es" value="2.2: release()  [status &#8594; AVAILABLE]" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;exitX=1;exitY=0.42;entryX=0;entryY=0.5;" edge="1" parent="1" source="oCtrl" target="oSeat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ew" value="2.4: [if CONFIRMED] refund(totalFare)" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;exitX=1;exitY=0.6;entryX=0;entryY=0.5;strokeColor=#0F766E;" edge="1" parent="1" source="oCtrl" target="oWallet"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et" value="2.5: record(REFUND txn)" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;exitX=1;exitY=0.78;entryX=0;entryY=0.5;strokeColor=#0F766E;" edge="1" parent="1" source="oCtrl" target="oTxn"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Messages 2.1–2.5 execute inside one atomic DB transaction. The refund path (2.4–2.5) runs only when the booking was CONFIRMED; a PENDING hold is simply released (2.2–2.3)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="440" width="470" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
