<mxfile host="app.diagrams.net" type="device">
  <diagram name="Activity - Book and Pay" id="act-booking">
    <mxGraphModel dx="1200" dy="1100" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

