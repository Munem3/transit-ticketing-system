        <mxCell id="a3" value="Hold seats (start 5-min timer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;arcSize=40;" vertex="1" parent="1"><mxGeometry x="150" y="384" width="220" height="44" as="geometry" /></mxCell>
        <mxCell id="a4" value="Choose wallet &amp; pay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;arcSize=40;" vertex="1" parent="1"><mxGeometry x="150" y="460" width="220" height="44" as="geometry" /></mxCell>
        <mxCell id="d2" value="Hold timer expired?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;" vertex="1" parent="1"><mxGeometry x="180" y="536" width="160" height="80" as="geometry" /></mxCell>
