        <mxCell id="a5" value="Charge wallet; CONFIRM booking; mark seats BOOKED; record txn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#0D9488;arcSize=25;" vertex="1" parent="1"><mxGeometry x="130" y="776" width="260" height="54" as="geometry" /></mxCell>
        <mxCell id="a6" value="Generate QR ticket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;arcSize=40;" vertex="1" parent="1"><mxGeometry x="150" y="862" width="220" height="44" as="geometry" /></mxCell>
        <mxCell id="a7" value="Display QR ticket to commuter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;arcSize=40;" vertex="1" parent="1"><mxGeometry x="150" y="926" width="220" height="44" as="geometry" /></mxCell>
        <mxCell id="fin" value="" style="ellipse;html=1;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="247" y="1000" width="26" height="26" as="geometry" /></mxCell>

