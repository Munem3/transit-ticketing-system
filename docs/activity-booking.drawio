          <mxGeometry x="40" y="12" width="560" height="26" as="geometry" />
        </mxCell>

        <!-- nodes -->
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="245" y="52" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="a1" value="Log in &amp; browse trips" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;arcSize=40;" vertex="1" parent="1"><mxGeometry x="150" y="108" width="220" height="44" as="geometry" /></mxCell>
        <mxCell id="a2" value="Select trip &amp; seats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#0F766E;arcSize=40;" vertex="1" parent="1"><mxGeometry x="150" y="184" width="220" height="44" as="geometry" /></mxCell>
