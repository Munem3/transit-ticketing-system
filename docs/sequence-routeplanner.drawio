        <mxCell id="acDB" value="" style="rounded=0;html=1;fillColor=#EAF6F3;strokeColor=#0F766E;" vertex="1" parent="1"><mxGeometry x="835" y="222" width="10" height="46" as="geometry" /></mxCell>
        <mxCell id="acG" value="" style="rounded=0;html=1;fillColor=#EAF6F3;strokeColor=#0F766E;" vertex="1" parent="1"><mxGeometry x="1085" y="314" width="10" height="46" as="geometry" /></mxCell>

        <mxCell id="m1" value="1: enter From, To, time" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="130" as="sourcePoint" /><mxPoint x="340" y="130" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: POST /api/ai/planner {from,to,when}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="176" as="sourcePoint" /><mxPoint x="590" y="176" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: fetch active routes (network)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="222" as="sourcePoint" /><mxPoint x="840" y="222" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: route list" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="268" as="sourcePoint" /><mxPoint x="590" y="268" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: prompt(network + journey)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="314" as="sourcePoint" /><mxPoint x="1090" y="314" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: JSON plan (legs, time, fare)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="360" as="sourcePoint" /><mxPoint x="590" y="360" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: parse &amp; validate JSON" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="398" as="sourcePoint" /><mxPoint x="590" y="420" as="targetPoint" /><Array as="points"><mxPoint x="665" y="398" /><mxPoint x="665" y="420" /></Array></mxGeometry></mxCell>
        <mxCell id="m8" value="8: plan {legs, minutes, fare}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="444" as="sourcePoint" /><mxPoint x="340" y="444" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9: show optimal multi-modal route" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="490" as="sourcePoint" /><mxPoint x="95" y="490" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="note" value="Fallback: if GEMINI_API_KEY is missing or the call fails, the API builds a heuristic plan from the DB route network — the flow is identical." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
