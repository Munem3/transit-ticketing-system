        <mxCell id="enote" value="Enums:  Role {USER, ADMIN}   ·   TransportMode {BUS, TRAIN, METRO}   ·   SeatStatus {AVAILABLE, HELD, BOOKED}   ·   BookingStatus {PENDING, CONFIRMED, CANCELLED, EXPIRED}   ·   TxnType {TOPUP, PURCHASE, REFUND}   ·   WalletProvider {BKASH, ROCKET, CARD}" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
