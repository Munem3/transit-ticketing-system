<mxfile host="app.diagrams.net" type="device">
  <diagram name="Class Diagram" id="class-diagram">
    <mxGraphModel dx="1400" dy="1000" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Class Diagram — TransitBD Ticketing System" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#0F766E;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="560" height="26" as="geometry" />
        </mxCell>

        <!-- User + subclasses -->
        <mxCell id="cUser" value="&lt;b&gt;User&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;- id: String&lt;br&gt;- name: String&lt;br&gt;- email: String&lt;br&gt;- phone: String&lt;br&gt;- passwordHash: String&lt;br&gt;- role: Role&lt;br&gt;- balance: Float&lt;hr size=&quot;1&quot;&gt;+ register()&lt;br&gt;+ login()&lt;br&gt;+ topUp(amount)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#EEF2FF;strokeColor=#0F766E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="220" height="205" as="geometry" />
        </mxCell>
        <mxCell id="cCommuter" value="&lt;b&gt;Commuter&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ bookTicket()&lt;br&gt;+ cancelBooking()&lt;br&gt;+ useAssistant()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#EEF2FF;strokeColor=#0F766E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="80" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cAdmin" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ manageTrip()&lt;br&gt;+ setFareGrid()&lt;br&gt;+ viewLedger()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#EEF2FF;strokeColor=#0F766E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Route / Trip / Seat -->
        <mxCell id="cRoute" value="&lt;b&gt;Route&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;- id: String&lt;br&gt;- code: String&lt;br&gt;- name: String&lt;br&gt;- mode: TransportMode&lt;br&gt;- origin: String&lt;br&gt;- destination: String&lt;br&gt;- baseFare: Float&lt;hr size=&quot;1&quot;&gt;+ listTrips()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#EEF2FF;strokeColor=#0F766E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="330" width="210" height="185" as="geometry" />
        </mxCell>
        <mxCell id="cTrip" value="&lt;b&gt;Trip&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;- id: String&lt;br&gt;- departure: DateTime&lt;br&gt;- arrival: DateTime&lt;br&gt;- vehicleLabel: String&lt;br&gt;- fareMultiplier: Float&lt;br&gt;- active: Boolean&lt;hr size=&quot;1&quot;&gt;+ availableSeats()&lt;br&gt;+ fare()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#EEF2FF;strokeColor=#0F766E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="230" height="185" as="geometry" />
        </mxCell>
        <mxCell id="cSeat" value="&lt;b&gt;Seat&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;- id: String&lt;br&gt;- label: String&lt;br&gt;- compartment: String&lt;br&gt;- status: SeatStatus&lt;br&gt;- holdExpiresAt: DateTime&lt;hr size=&quot;1&quot;&gt;+ hold()&lt;br&gt;+ release()&lt;br&gt;+ book()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#EEF2FF;strokeColor=#0F766E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="205" height="175" as="geometry" />
        </mxCell>

        <!-- Booking / Transaction / QRTicket -->
        <mxCell id="cBooking" value="&lt;b&gt;Booking&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;- id: String&lt;br&gt;- reference: String&lt;br&gt;- status: BookingStatus&lt;br&gt;- totalFare: Float&lt;br&gt;- holdExpiresAt: DateTime&lt;br&gt;- qrPayload: String&lt;br&gt;- createdAt: DateTime&lt;hr size=&quot;1&quot;&gt;+ holdSeats()&lt;br&gt;+ confirm(provider)&lt;br&gt;+ cancel()&lt;br&gt;+ generateQR()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#D5F5E3;strokeColor=#0D9488;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="590" width="250" height="240" as="geometry" />
        </mxCell>
        <mxCell id="cTxn" value="&lt;b&gt;Transaction&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;- id: String&lt;br&gt;- type: TxnType&lt;br&gt;- provider: WalletProvider&lt;br&gt;- amount: Float&lt;br&gt;- balanceAfter: Float&lt;br&gt;- createdAt: DateTime" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#EEF2FF;strokeColor=#0F766E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="600" width="230" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cQR" value="&lt;b&gt;QRTicket&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;- id: String&lt;br&gt;- payload: String&lt;br&gt;- createdAt: DateTime&lt;hr size=&quot;1&quot;&gt;+ generate()&lt;br&gt;+ verify()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#EEF2FF;strokeColor=#0F766E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="600" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- AI service + external Gemini -->
        <mxCell id="cAI" value="&lt;b&gt;AIService&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ predictDemand(routeId)&lt;br&gt;+ planRoute(from, to)&lt;br&gt;+ answerSupport(msg)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#D5F5E3;strokeColor=#0D9488;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="330" width="240" height="120" as="geometry" />
