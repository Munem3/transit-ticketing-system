        <mxCell id="cGemini" value="&lt;&lt;external&gt;&gt;&lt;br&gt;&lt;b&gt;GeminiAPI&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ generateContent(prompt)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="500" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- Generalizations (hollow triangle to superclass) -->
        <mxCell id="gCom" style="endArrow=block;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;" edge="1" parent="1" source="cCommuter" target="cUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gAdm" style="endArrow=block;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;" edge="1" parent="1" source="cAdmin" target="cUser"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Associations with multiplicities -->
        <mxCell id="rUB" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;" edge="1" parent="1" source="cUser" target="cBooking"><mxGeometry relative="1" as="geometry" /></mxCell>
