        <mxCell id="rUT" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;" edge="1" parent="1" source="cUser" target="cTxn"><mxGeometry relative="1" as="geometry" /></mxCell>
