# --- Database ---
# SQLite (default, zero-config for local dev):
DATABASE_URL="file:./dev.db"
# To use PostgreSQL instead, change the provider in prisma/schema.prisma to
# "postgresql" and set, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/transit?schema=public"

# --- NextAuth ---
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Google Gemini (optional) ---
# If left blank, the AI features fall back to built-in heuristics so the app
# still works. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
